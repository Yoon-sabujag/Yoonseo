{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/app.js", "dest": "/frontend/bootstrap.js" },
    { "src": "/app-original.js", "dest": "/frontend/app.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
